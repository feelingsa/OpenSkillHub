{
  "name": "skill-web-hub",
  "version": "0.1.0",
  "description": "LAN-accessible OpenCode Skill Web Hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:api": "vitest run tests/api.test.ts",
    "test:browser": "node scripts/check-browser.mjs",
    "test:performance": "tsx scripts/performance-smoke.ts",
    "validate:real-page": "tsx scripts/validate-real-page-generation.ts",
    "capture:desktop": "node scripts/capture-desktop-baseline.mjs",
    "capture:admin": "node scripts/capture-admin-desktop.mjs",
    "audit:design": "node scripts/audit-design-sources.mjs"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/static": "10.1.2",
    "better-sqlite3": "13.0.1",
    "fastify": "5.10.0",
    "gsap": "3.13.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.1",
    "playwright-core": "^1.61.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
