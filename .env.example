# The Node service is the only LAN-facing process. Keep OpenCode on loopback.
HUB_HOST=0.0.0.0
HUB_PORT=5177
HUB_DATA_PATH=./data/skill-web-hub.db
HUB_LOG_LEVEL=info

# connect: use an already running OpenCode server
# managed: Node launches OpenCode with the command and JSON argument array below
OPENCODE_MODE=connect
OPENCODE_URL=http://127.0.0.1:4197
OPENCODE_COMMAND=opencode
OPENCODE_ARGS_JSON=["serve","--hostname","127.0.0.1","--port","4096"]
OPENCODE_WORKING_DIRECTORY=.
OPENCODE_START_TIMEOUT_MS=15000

# JSON array. Only these directories may be read by the Skill scanner.
# Leave empty to use provider API discovery only.
OPENCODE_SKILL_ROOTS_JSON=[]
# Set false only for controlled filesystem-only scans, such as isolated validation.
OPENCODE_API_SKILL_DISCOVERY=true
# Optional explicit model routing. Set both fields to prevent OpenCode's own default model from being used.
OPENCODE_MODEL_PROVIDER=xingwan
OPENCODE_MODEL_ID=gpt-5.6-terra
OPENCODE_MODEL_VARIANT=medium
SKILL_SYNC_INTERVAL_MS=300000
HUB_RUN_TIMEOUT_MS=900000
HUB_PAGE_GENERATION_TIMEOUT_MS=120000
# OpenCode creates generated files here before Node validates and persists them into frontend/generated.
# HUB_PAGE_GENERATION_TEMP_ROOT=C:\\path\\to\\system-temp\\skill-web-hub-page-generation
# Updating this value marks previously generated pages as stale and regenerates them without deleting old versions.
HUB_PAGE_PROMPT_VERSION=skill-page-contract-v1

# Bootstrap administrator for /admin. Use a unique, long password before sharing on the LAN.
HUB_ADMIN_USERNAME=admin
HUB_ADMIN_PASSWORD=replace-with-a-long-unique-password
HUB_SESSION_TTL_MS=86400000
# Completed run workspaces and registered artifacts older than this are eligible for explicit admin cleanup.
HUB_ARTIFACT_RETENTION_DAYS=30
